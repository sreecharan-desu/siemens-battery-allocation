{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,.venv/**,node_modules/**,.git/**,benchmarks/**,docs/**,outputs/**,**/*.md,**/*.pdf,**/*.docx}"
    }
  }
}
